# cosmai dashboard image — static Vite build served by nginx (M8 deploy, see
# docs/p1/M8-DEPLOY-RECORD.md).
#
# Build context is `apps/` (shared with `Dockerfile`); this file only touches
# `dashboard/`. Built with `build: { context: ..., dockerfile: Dockerfile.dashboard }`
# in the stack compose.
#
# **The API base needs no build argument.** `dashboard/src/api/client.ts`'s
# `DEFAULT_API_BASE` is already `http://127.0.0.1:8100` (M-X2's fix, matching
# `platform_core.config`'s own `COSMA_API_PORT` default) — exactly the address
# the browser reaches the api container at (loopback-published, per
# docker-compose.yml). `VITE_API_BASE` exists as an override for a build served
# from somewhere else; this deployment does not need one, so this file passes
# none, which is the "mechanism that requires least change" the deploy brief
# asked for. If `COSMAI_API_PORT` is ever moved off `8100`, this build needs
# `--build-arg VITE_API_BASE=http://127.0.0.1:<port>` (see the commented ARG
# below) — recorded here so that day does not have to rediscover it.
FROM node:22-slim AS build
WORKDIR /src

COPY dashboard/package.json dashboard/package-lock.json ./
RUN npm ci

COPY dashboard/ ./
# Uncomment to point the build at a non-default API origin:
# ARG VITE_API_BASE
# ENV VITE_API_BASE=${VITE_API_BASE}
RUN npm run build

FROM nginx:alpine
COPY --from=build /src/dist /usr/share/nginx/html
# SPA fallback for react-router-dom's BrowserRouter — see the file's own comment.
COPY dashboard/nginx.conf /etc/nginx/conf.d/default.conf
